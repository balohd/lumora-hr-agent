# Copy to .env for local development. Never commit .env.

# ---- LLM (optional; without a key the app runs in deterministic offline template mode)
LLM_PROVIDER=groq                 # groq | openrouter | openai | custom | none
GROQ_API_KEY=                     # free tier: https://console.groq.com
# OPENROUTER_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=                   # required for LLM_PROVIDER=custom
LLM_TEMPERATURE=0

# ---- Agent
AGENT_MODE=planner                # planner (deterministic workflows + LLM synthesis) | react (LLM tool-calling)
RETRIEVAL_K=5
EVIDENCE_COVERAGE_MIN=0.5
# HR_TODAY=2026-10-30             # pin "today" for reproducible demos/evaluation

# ---- RAG
EMBEDDING_PROVIDER=auto           # auto (fastembed, fallback lsa) | fastembed | lsa
CHUNK_MAX_WORDS=220
CHUNK_OVERLAP_WORDS=40
RETRIEVAL_MODE=hybrid             # hybrid | dense | lexical
SEED=42

# ---- MCP
# MCP_SERVER_URL=http://localhost:8765/mcp   # set to use a separately deployed MCP server (Streamable HTTP)
# MCP_DISABLED_TOOLS=check_pto_balance       # simulate tool outages / ablations
